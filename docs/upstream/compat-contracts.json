{
  "$comment": "Upstream DOM/CSS contracts this plugin depends on, in machine-readable form. Consumer: node scripts/cdp-compat-contracts.mjs \u2014 it loads the live page (touch emulation on) and reports HIT / MISS / SKIP per entry. `lazy: true` means the markup only exists in some state (a session open, a tab selected, a dialog open): a MISS is reported as SKIP with the manual step that would reveal it and does not fail the run. A MISS on a non-lazy entry fails the run. Run it after every host upgrade, before anything is reported broken.",
  "contracts": [
    {
      "id": "shell-overlay",
      "kind": "marker",
      "needle": "[data-shell-overlay]",
      "owner": "dsh-client-ui-layout",
      "lazy": false,
      "note": "AppFrame overlay layer: findFrame() anchors the drawer / FAB / backdrop here"
    },
    {
      "id": "composer-card",
      "kind": "marker",
      "needle": "[data-composer-card]",
      "owner": "dsh-client-ui-conversation",
      "lazy": true,
      "state": "open any session",
      "note": "composer capsule root: keyboard guard, file input, tool-row scoping"
    },
    {
      "id": "composer-input",
      "kind": "marker",
      "needle": "[data-composer-input]",
      "owner": "dsh-client-ui-conversation",
      "lazy": true,
      "state": "open any session",
      "note": "Lexical editing surface: focus shadow + stats-row exclusion"
    },
    {
      "id": "composer-seat",
      "kind": "marker",
      "needle": "[data-composer-seat]",
      "owner": "dsh-client-ui-conversation",
      "lazy": true,
