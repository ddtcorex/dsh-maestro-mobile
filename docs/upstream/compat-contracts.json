      "note": "stats-row hunter scopes to the composer stack"
    },
    {
      "id": "composer-modes",
      "kind": "hash",
      "needle": "_modes",
      "owner": "dsh-client-ui-conversation",
      "lazy": true,
      "state": "open any session",
      "note": "access-mode / plan seat row"
    },
    {
      "id": "composer-tools",
