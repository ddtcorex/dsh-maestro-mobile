      "needle": "[data-conversation-composer-overlay]",
      "owner": "dsh-client-ui-conversation",
      "lazy": true,
      "state": "open a conversation.view tab (trajectory)",
      "note": "generic view-overlay flag: the swipe layer yields the left edge to it"
    },
    {
      "id": "phase-root",
      "kind": "marker",
      "needle": "[data-phase]",
      "owner": "dsh-client-ui-conversation",
      "lazy": true,
      "state": "open any session",
      "note": "phase root: tooltip suppression scope + safe-area rules"
    },
    {
      "id": "question-key",
      "kind": "marker",
      "needle": "[data-question-key]",
      "owner": "dsh-client-ui-user-questions",
